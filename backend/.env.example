# === Google AI Studio (Gemini / Gemma) ===
GEMINI_API_KEY=

# === Qwen / ModelScope API-Inference (OpenAI-compatible) ===
# Lấy API key ModelScope ở https://modelscope.ai (dạng ms-xxxxxxxx).
QWEN_API_KEY=
# Base URL của ModelScope API-Inference (server quốc tế .ai). Người dùng có thể
# ghi đè trong ⚙ Cài đặt cho từng tài khoản.
QWEN_BASE_URL=https://api-inference.modelscope.ai/v1
# Tên model trên ModelScope.
QWEN_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# === App ===
# Danh sách origin của frontend (phân tách bằng dấu phẩy). Khi deploy Vercel,
# thêm đúng URL frontend, ví dụ: https://mai-tam-translate.vercel.app
BACKEND_CORS_ORIGINS=http://localhost:5173
STORAGE_DIR=./storage
# Thời hạn nhớ đăng nhập, tự gia hạn khi user còn dùng app (rolling session).
AUTH_SESSION_DAYS=365
# Khi deploy qua HTTPS, đặt AUTH_COOKIE_SECURE=true.
AUTH_COOKIE_SECURE=false
# SameSite cookie phiên. Dev cùng localhost để "lax".
# Deploy frontend (Vercel) và backend KHÁC domain là cross-site -> đặt "none"
# (sẽ tự bật Secure, nên backend bắt buộc chạy HTTPS).
AUTH_COOKIE_SAMESITE=lax
# Khuyến nghị đặt chuỗi secret dài, riêng cho server production.
# Nếu để trống, app tự tạo backend/storage/cache/auth_secret.key trên máy hiện tại.
AUTH_SECRET_KEY=

# Tài khoản admin đầu tiên (bootstrap khi database chưa có admin nào).
# Bắt buộc phải đặt trước lần chạy đầu tiên — không có nút đăng ký công khai,
# chỉ admin mới tạo được tài khoản khác qua giao diện quản trị.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# === Giới hạn quota mặc định (placeholder — xác nhận lại trước khi tích hợp thật) ===
GEMINI_RPM_LIMIT=15
GEMINI_TPM_LIMIT=250000
GEMINI_RPD_LIMIT=1500
GEMINI_MAX_TOKENS_PER_REQUEST=65536
GEMMA_RPM_LIMIT=30
GEMMA_TPM_LIMIT=15000
GEMMA_RPD_LIMIT=14400
GEMMA_MAX_TOKENS_PER_REQUEST=8192
QWEN_RPM_LIMIT=60
QWEN_TPM_LIMIT=100000
QWEN_RPD_LIMIT=500
QWEN_MAX_TOKENS_PER_REQUEST=16384
