# === Google AI Studio (Gemini / Gemma) ===
GEMINI_API_KEY=

# === Qwen / ModelScope (OpenAI-compatible) ===
QWEN_API_KEY=
QWEN_BASE_URL=https://api-inference.modelscope.ai/v1

# === App ===
BACKEND_CORS_ORIGINS=http://localhost:5173
STORAGE_DIR=./storage
DEFAULT_TARGET_LANG=vi

# === Giới hạn quota mặc định (placeholder — xác nhận lại trước khi tích hợp thật) ===
GEMINI_RPM_LIMIT=15
GEMINI_TPM_LIMIT=1000000
GEMINI_RPD_LIMIT=1500
QWEN_RPM_LIMIT=60
QWEN_TPM_LIMIT=100000
# ModelScope free: 2000 lượt/ngày chung mọi model, tối đa 500 lượt/model/ngày
QWEN_RPD_LIMIT=500
